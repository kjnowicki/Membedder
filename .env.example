DISCORD_BOT_TOKEN=your_actual_token_xyz_123_abc

# Optional: Load cookies from a browser for yt-dlp (e.g. chrome, firefox, edge, safari, opera, brave)
# useful when running locally without docker
# COOKIES_FROM_BROWSER=chrome

# Optional: Comma-separated Discord user IDs allowed to configure embed tracking duration (!tracking)
# ADMIN_USER_IDS=123456789012345678